{
  "name": "tackle-issue",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.5.2",
  "scripts": {
    "line:replay": "node scripts/line-replay.mjs",
    "preinstall": "node scripts/ensure-pnpm.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "tsx server/index.ts",
    "dev:reset": "tsx scripts/dev-reset.ts",
    "pilot:verify": "tsx scripts/pilot-verify.ts",
    "dev:convex": "node scripts/convex-local.mjs dev",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "identity:restore": "tsx scripts/identity-restore.ts",
    "ticket": "tsx scripts/ticket.ts",
    "convex:local": "node scripts/convex-local.mjs",
    "test": "pnpm run test:unit && pnpm run test:convex",
    "test:unit": "tsx --tsconfig tsconfig.test.json --test tests/*.test.ts",
    "test:convex": "vitest run --config vitest.convex.config.ts",
    "test:one": "tsx --tsconfig tsconfig.test.json --test",
    "typecheck": "tsgo -b",
    "typecheck:tsc": "tsc -b",
    "check": "concurrently --group --names typecheck,lint,unit,convex,build \"pnpm:typecheck\" \"pnpm:lint\" \"pnpm:test:unit\" \"pnpm:test:convex\" \"vite build --logLevel warn\"",
    "agent:setup": "node scripts/agent-setup.mjs",
    "agent:new": "node scripts/agent-new.mjs",
    "test:browser": "tsx scripts/test-browser.mjs",
    "test:explore": "tsx scripts/test-browser.mjs --suite explore",
    "test:visual": "tsx scripts/visual-pilot.ts",
    "browser:evidence": "tsx scripts/browser-evidence-cli.ts",
    "check:arch": "pnpm test:one tests/architecture.test.ts tests/function_policies.test.ts",
    "lint": "eslint \"src/**/*.{ts,tsx}\" --max-warnings=0",
    "test:mutation": "node scripts/test-ticket-mutations.mjs",
    "test:retention-model": "sh verification/tla/run.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@convex-dev/auth": "2.0.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hono/node-server": "^1.14.4",
    "@radix-ui/react-progress": "^1.1.11",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.0",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-virtual": "^3.14.12",
    "@uploadthing/react": "^7.3.3",
    "@uploadthing/shared": "7.1.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "1.49.0",
    "dotenv": "^17.4.2",
    "embla-carousel": "8.6.0",
    "embla-carousel-react": "^8.6.0",
    "hono": "^4.8.4",
    "image-size": "^2.1.0",
    "lucide-react": "^0.468.0",
    "parse5": "^8.1.1",
    "pdf-lib": "1.17.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.34.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "uploadthing": "^7.7.4",
    "zod": "^3.25.67"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@edge-runtime/vm": "5.0.0",
    "@types/node": "^22.10.2",
    "@types/pngjs": "6.0.5",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "@vitejs/plugin-react": "^4.3.4",
    "adm-zip": "^0.6.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.2",
    "convex-test": "0.0.71",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "pixelmatch": "8.0.0",
    "playwright": "^1.61.1",
    "pngjs": "7.0.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "3.2.7"
  }
}
