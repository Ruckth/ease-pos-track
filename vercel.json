{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "pnpm run build:vercel",
  "git": { "deploymentEnabled": { "main": true } },
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/staff", "destination": "/index.html" },
    { "source": "/staff/login", "destination": "/index.html" },
    { "source": "/staff/invite", "destination": "/index.html" },
    { "source": "/staff/settings/t3", "destination": "/index.html" },
    { "source": "/staff/settings/line", "destination": "/index.html" },
    { "source": "/customer/join", "destination": "/index.html" },
    { "source": "/customer/recover", "destination": "/index.html" },
    { "source": "/customer", "destination": "/index.html" },
    { "source": "/customer/login", "destination": "/index.html" },
    { "source": "/customer/register", "destination": "/index.html" }
  ]
}
