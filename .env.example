UPLOADTHING_TOKEN=
VITE_CONVEX_URL=
CONVEX_URL=
APP_PASSWORD=
# REQUIRED for customer accounts. Its value is mixed into every customer password
# derivation (PBKDF2-HMAC-SHA256, per-account salt), so leaked database rows alone
# cannot be attacked offline. Customer sign-up and sign-in fail closed while it is
# unset. Set it once, before the first customer registers: changing or removing it
# later invalidates every existing customer password. Configure it on the Convex
# deployment (`pnpm convex env set CUSTOMER_PASSWORD_PEPPER <value>`), not in this
# file — the app server never reads it. Use a long random value, for example
# `openssl rand -hex 32`.
CUSTOMER_PASSWORD_PEPPER=
