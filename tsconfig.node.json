{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "tsBuildInfoFile": "./node_modules/.cache/tsc/node.tsbuildinfo",
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["convex-auth-internal-types"],
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["vite.config.ts", "api/**/*.ts", "scripts/**/*.ts", "server/**/*.ts", "convex/**/*.ts", "shared/**/*.ts"]
}
